# Copiar este archivo como .env y completar con los valores de tu proyecto.
# Nunca subir el archivo .env con las claves reales.

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon publica. Se puede exponer en el navegador.
# Se obtiene en Supabase > Project Settings > API.
# NUNCA usar aqui la clave service_role: esa da acceso total al servidor.
VITE_SUPABASE_ANON_KEY=tu-clave-anon
